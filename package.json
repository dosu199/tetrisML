{
  "name": "tetris-ml",
  "version": "0.31.0",
  "description": "Tetris with a neural network that learns to play by deep Q-learning, plus a search bot to compare it against",
  "type": "module",
  "scripts": {
    "test": "node tests/bench.js --test && node tests/test-dqn.js",
    "test:dqn": "node tests/test-dqn.js",
    "bench": "node tests/bench.js",
    "train:dqn": "node scripts/train-dqn.js",
    "train:many": "node scripts/train-many.js",
    "hard": "node scripts/hardmode.js --games 10 --cap 2000",
    "hard:full": "node scripts/hardmode.js --games 50 --seed 90000 --mode no-preview",
    "hard:hold": "node scripts/hardmode.js --hold --games 50 --seed 90000 --mode memoryless-no-preview",
    "hard:deep": "node scripts/hardmode.js --hold --lookahead --deep --games 50 --seed 90000 --mode garbage3",
    "hard:lookahead": "node scripts/hardmode.js --lookahead --games 50 --seed 90000 --mode garbage5",
    "train:ga": "node scripts/legacy-ga/train.js",
    "compare:ga": "node scripts/legacy-ga/compare.js"
  }
}
